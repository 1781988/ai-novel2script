page {
  background: #fffaf4;
  color: #111a3b;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
  padding-bottom: 150rpx;
  background:
    linear-gradient(180deg, #fffaf4 0%, #f8f5ff 46%, #fffaf4 100%);
}

.section {
  margin-top: 28rpx;
}

.panel {
  padding: 28rpx;
  border: 1rpx solid rgba(122, 101, 255, 0.12);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 20rpx 56rpx rgba(78, 91, 177, 0.12);
}

.primary-button {
  min-height: 96rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #6e68ff, #8b55ff);
  font-weight: 700;
  box-shadow: 0 16rpx 34rpx rgba(111, 93, 255, 0.28);
}

.secondary-button {
  min-height: 86rpx;
  border-radius: 24rpx;
  color: #152047;
  background: #f3f5ff;
  border: 0;
}

.muted {
  color: #697189;
}

.field-label {
  display: block;
  margin: 24rpx 0 12rpx;
  color: #4f5873;
  font-size: 28rpx;
}

input,
picker {
  box-sizing: border-box;
  min-height: 88rpx;
  width: 100%;
  padding: 0 24rpx;
  border: 1rpx solid rgba(122, 101, 255, 0.16);
  border-radius: 22rpx;
  background: #ffffff;
  color: #111a3b;
  font-size: 30rpx;
}
