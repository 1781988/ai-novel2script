page {
  background: #101723;
  color: #f5efe3;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
  background:
    linear-gradient(180deg, rgba(255, 214, 125, 0.08), rgba(16, 23, 35, 0) 260rpx),
    radial-gradient(circle at 20% 0%, rgba(255, 198, 93, 0.18), transparent 300rpx),
    #101723;
}

.section {
  margin-top: 28rpx;
}

.panel {
  padding: 28rpx;
  border: 1rpx solid rgba(255, 221, 160, 0.18);
  border-radius: 8rpx;
  background: rgba(22, 31, 45, 0.92);
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.22);
}

.primary-button {
  color: #1a1208;
  background: linear-gradient(135deg, #ffd27a, #f08a3c);
  font-weight: 700;
}

.secondary-button {
  color: #f5efe3;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 221, 160, 0.18);
}

.muted {
  color: #aeb9c8;
}

.field-label {
  display: block;
  margin: 24rpx 0 12rpx;
  color: #d9c7a1;
  font-size: 28rpx;
}

input,
picker {
  box-sizing: border-box;
  min-height: 88rpx;
  width: 100%;
  padding: 0 24rpx;
  border: 1rpx solid rgba(255, 221, 160, 0.18);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #f5efe3;
  font-size: 30rpx;
}
