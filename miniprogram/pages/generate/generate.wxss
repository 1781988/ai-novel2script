.page-title {
  margin-bottom: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.panel-title {
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.submit-button {
  margin-top: 28rpx;
}

.step-row {
  display: grid;
  grid-template-columns: 24rpx 1fr auto;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #edf1f6;
}

.step-row:first-of-type {
  border-top: 0;
}

.step-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #c5d0df;
}

.step-row.running .step-dot {
  background: #1f6feb;
}

.step-row.done .step-dot {
  background: #1f8f4d;
}

.step-status {
  color: #6b7787;
  font-size: 24rpx;
}

.yaml-output {
  box-sizing: border-box;
  width: 100%;
  min-height: 520rpx;
  padding: 22rpx;
  border: 1rpx solid #ccd6e3;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #172331;
  font-family: monospace;
  font-size: 24rpx;
  line-height: 1.5;
}

.button-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 18rpx;
}
