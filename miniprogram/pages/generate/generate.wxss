.page-title {
  margin-bottom: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #111a3b;
}

.generate-hero {
  background: linear-gradient(135deg, #ffffff, #f2efff);
}

.eyebrow {
  color: #756bff;
  font-size: 24rpx;
  font-weight: 700;
}

.panel-title {
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #111a3b;
}

.submit-button {
  margin-top: 28rpx;
}

.step-row {
  display: grid;
  grid-template-columns: 34rpx 1fr auto;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #edf0f8;
  color: #18224a;
}

.step-row:first-of-type {
  border-top: 0;
}

.step-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: #d9ddf0;
}

.step-row.running .step-dot {
  background: #756bff;
  box-shadow: 0 0 18rpx rgba(117, 107, 255, 0.45);
}

.step-row.done .step-dot {
  background: #62d27f;
}

.step-status {
  color: #697189;
  font-size: 24rpx;
}

.yaml-output {
  box-sizing: border-box;
  width: 100%;
  min-height: 520rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(122, 101, 255, 0.16);
  border-radius: 22rpx;
  background: #f8f7ff;
  color: #111a3b;
  font-family: monospace;
  font-size: 24rpx;
  line-height: 1.5;
}

.button-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 18rpx;
}
