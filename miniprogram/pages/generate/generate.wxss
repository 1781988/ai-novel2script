.page-title {
  margin-bottom: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #fff7e7;
}

.generate-hero {
  background: linear-gradient(145deg, rgba(30, 49, 72, 0.95), rgba(94, 35, 32, 0.76));
}

.eyebrow {
  color: #ffd27a;
  font-size: 24rpx;
  font-weight: 700;
}

.panel-title {
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff7e7;
}

.submit-button {
  margin-top: 28rpx;
}

.step-row {
  display: grid;
  grid-template-columns: 34rpx 1fr auto;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #e8edf4;
}

.step-row:first-of-type {
  border-top: 0;
}

.step-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.22);
}

.step-row.running .step-dot {
  background: #ffd27a;
  box-shadow: 0 0 18rpx rgba(255, 210, 122, 0.7);
}

.step-row.done .step-dot {
  background: #62d27f;
}

.step-status {
  color: #aeb9c8;
  font-size: 24rpx;
}

.yaml-output {
  box-sizing: border-box;
  width: 100%;
  min-height: 520rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 221, 160, 0.18);
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.22);
  color: #f5efe3;
  font-family: monospace;
  font-size: 24rpx;
  line-height: 1.5;
}

.button-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 18rpx;
}
