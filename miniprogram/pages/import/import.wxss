.page-title {
  margin-bottom: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #111a3b;
}

.novel-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 440rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(122, 101, 255, 0.16);
  border-radius: 24rpx;
  background: #ffffff;
  color: #111a3b;
  font-size: 28rpx;
  line-height: 1.6;
}

.button-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}

.submit-button {
  margin-top: 24rpx;
}

.result-panel {
  display: grid;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 8rpx;
}

.result-panel.valid {
  background: #e9fff4;
  color: #1f9b62;
}

.result-panel.invalid {
  background: #fff0e5;
  color: #ff8744;
}
