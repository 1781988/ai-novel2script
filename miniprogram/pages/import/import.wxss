.page-title {
  margin-bottom: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #fff7e7;
}

.novel-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 440rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 221, 160, 0.18);
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.22);
  color: #f5efe3;
  font-size: 28rpx;
  line-height: 1.6;
}

.button-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}

.submit-button {
  margin-top: 24rpx;
}

.result-panel {
  display: grid;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 8rpx;
}

.result-panel.valid {
  background: rgba(98, 210, 127, 0.12);
  color: #9ff0b2;
}

.result-panel.invalid {
  background: rgba(240, 138, 60, 0.14);
  color: #ffd27a;
}
