.home-page {
  padding-top: 36rpx;
}

.stage-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-height: 420rpx;
  padding: 34rpx 30rpx;
  border: 1rpx solid rgba(255, 221, 160, 0.22);
  border-radius: 8rpx;
  background:
    linear-gradient(145deg, rgba(121, 35, 28, 0.72), rgba(18, 30, 47, 0.88)),
    linear-gradient(90deg, rgba(0, 0, 0, 0.22), transparent);
  box-shadow: 0 26rpx 70rpx rgba(0, 0, 0, 0.36);
  overflow: hidden;
}

.curtain-line {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 12rpx;
  background: linear-gradient(90deg, #a33c32, #ffd27a, #a33c32);
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border: 1rpx solid rgba(255, 221, 160, 0.5);
  border-radius: 8rpx;
  color: #ffd27a;
  font-size: 22rpx;
  font-weight: 800;
}

.eyebrow {
  color: #ffd27a;
  font-size: 26rpx;
  font-weight: 600;
}

.title {
  color: #fff7e7;
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1.05;
}

.subtitle {
  max-width: 610rpx;
  color: #e4d7bd;
  font-size: 30rpx;
  line-height: 1.6;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.metric {
  padding: 18rpx 14rpx;
  border: 1rpx solid rgba(255, 221, 160, 0.18);
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.18);
}

.metric-value {
  display: block;
  color: #ffd27a;
  font-size: 30rpx;
  font-weight: 800;
}

.metric-label {
  display: block;
  margin-top: 4rpx;
  color: #bfc8d5;
  font-size: 22rpx;
}

.actions {
  display: grid;
  gap: 20rpx;
  margin-top: 28rpx;
}

.action-main {
  min-height: 96rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.panel-title {
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff7e7;
}

.flow-row {
  display: grid;
  grid-template-columns: 54rpx 1fr;
  gap: 10rpx 16rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.flow-row:first-of-type {
  border-top: 0;
}

.flow-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  color: #1a1208;
  background: #ffd27a;
  font-size: 24rpx;
  font-weight: 800;
}

.flow-name {
  color: #fff7e7;
  font-weight: 700;
}

.flow-row .muted {
  grid-column: 2;
  line-height: 1.5;
}
