<view class="page home-page">
  <view class="stage-hero">
    <view class="curtain-line"></view>
    <view class="brand-row">
      <text class="brand-mark">CS</text>
      <text class="eyebrow">ChapterStage</text>
    </view>
    <text class="title">章幕引擎</text>
    <text class="subtitle">把小说章节压入叙事引擎，输出人物、分集、场景与可校验的剧本 YAML。</text>
    <view class="metrics">
      <view class="metric">
        <text class="metric-value">3+</text>
        <text class="metric-label">章节输入</text>
      </view>
      <view class="metric">
        <text class="metric-value">YAML</text>
        <text class="metric-label">结构剧本</text>
      </view>
      <view class="metric">
        <text class="metric-value">AI</text>
        <text class="metric-label">分阶段生成</text>
      </view>
    </view>
  </view>

  <view class="actions">
    <button class="primary-button action-main" bindtap="goCreate">启动改编工程</button>
    <view class="action-grid">
      <button class="secondary-button" bindtap="goImport">导入小说</button>
      <button class="secondary-button" bindtap="useSample">示例体验</button>
      <button class="secondary-button" bindtap="showComingSoon">历史剧本</button>
      <button class="secondary-button" bindtap="goSettings">模型设置</button>
    </view>
  </view>

  <view class="section panel">
    <view class="panel-title">改编流水线</view>
    <view class="flow-row" wx:for="{{flow}}" wx:key="name">
      <text class="flow-index">{{index + 1}}</text>
      <text class="flow-name">{{item.name}}</text>
      <text class="muted">{{item.desc}}</text>
    </view>
  </view>
</view>
