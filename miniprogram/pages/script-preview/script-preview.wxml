<view class="page">
  <view class="panel">
    <view class="page-title">{{title}}</view>
    <view class="muted">校验状态：{{validationStatus}}</view>
    <view class="button-grid">
      <button class="secondary-button" bindtap="goYaml">YAML 编辑</button>
      <button class="secondary-button" bindtap="goRelations">人物关系图</button>
      <button class="secondary-button" bindtap="goVersions">版本记录</button>
      <button class="secondary-button" bindtap="saveVersion">保存版本</button>
    </view>
  </view>

  <view class="section panel">
    <view class="panel-title">人物表</view>
    <view class="list-row" wx:for="{{screenplay.characters}}" wx:key="characterId">{{item.name}}：{{item.description}}</view>
  </view>

  <view class="section panel">
    <view class="panel-title">地点表</view>
    <view class="list-row" wx:for="{{screenplay.locations}}" wx:key="locationId">{{item.name}}：{{item.description}}</view>
  </view>

  <view class="section panel">
    <view class="panel-title">分集列表</view>
    <view class="list-row" wx:for="{{screenplay.episodes}}" wx:key="episodeId">第 {{item.order}} 集：{{item.title}} - {{item.summary}}</view>
  </view>

  <view class="section">
    <scene-card wx:for="{{screenplay.scenes}}" wx:key="sceneId" scene="{{item}}" bind:edit="editScene" />
  </view>
</view>
