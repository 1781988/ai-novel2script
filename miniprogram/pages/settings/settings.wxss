.page-title {
  margin-bottom: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.picker-value {
  display: flex;
  align-items: center;
  min-height: 88rpx;
}

.model-card {
  display: grid;
  gap: 10rpx;
  margin: 28rpx 0;
  padding: 24rpx;
  border: 1rpx solid #d9e1ec;
  border-radius: 8rpx;
  background: #f8fafc;
}

.model-name {
  font-size: 34rpx;
  font-weight: 700;
}

button + button {
  margin-top: 18rpx;
}

.result {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #eef6f0;
  color: #19623a;
}
