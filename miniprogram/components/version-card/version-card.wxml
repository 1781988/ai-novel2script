<view class="version-card">
  <view class="head">
    <text class="title">版本 {{version.versionNo}}</text>
    <text class="muted">{{version.versionName}}</text>
  </view>
  <view class="summary">{{version.changeSummary}}</view>
  <button class="secondary-button" bindtap="restore">恢复此版本</button>
</view>
