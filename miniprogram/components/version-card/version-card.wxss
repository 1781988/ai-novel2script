.version-card {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(122, 101, 255, 0.12);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(78, 91, 177, 0.1);
}

.head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.title {
  font-weight: 700;
  color: #111a3b;
}

.muted {
  color: #697189;
}

.summary {
  margin: 12rpx 0;
  color: #4f5873;
}
