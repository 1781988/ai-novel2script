.version-card {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 221, 160, 0.18);
  border-radius: 8rpx;
  background: rgba(22, 31, 45, 0.92);
}

.head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.title {
  font-weight: 700;
  color: #fff7e7;
}

.muted {
  color: #aeb9c8;
}

.summary {
  margin: 12rpx 0;
  color: #d5deea;
}
