.chapter-card {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(122, 101, 255, 0.12);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(78, 91, 177, 0.1);
}

.chapter-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  color: #697189;
  font-size: 26rpx;
}

.order {
  font-weight: 700;
}

.title-input {
  min-height: 76rpx;
  padding: 0 18rpx;
  font-weight: 700;
}

.excerpt {
  margin-top: 16rpx;
  color: #4f5873;
  font-size: 28rpx;
  line-height: 1.6;
}

.preview-button {
  margin-top: 18rpx;
}
