.chapter-card {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 221, 160, 0.18);
  border-radius: 8rpx;
  background: rgba(22, 31, 45, 0.92);
}

.chapter-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  color: #aeb9c8;
  font-size: 26rpx;
}

.order {
  font-weight: 700;
}

.title-input {
  min-height: 76rpx;
  padding: 0 18rpx;
  font-weight: 700;
}

.excerpt {
  margin-top: 16rpx;
  color: #d5deea;
  font-size: 28rpx;
  line-height: 1.6;
}

.preview-button {
  margin-top: 18rpx;
}
