.episode-card {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 221, 160, 0.18);
  border-radius: 8rpx;
  background: rgba(22, 31, 45, 0.92);
}

.episode-head {
  display: flex;
  justify-content: space-between;
  color: #aeb9c8;
  font-size: 24rpx;
}

.card-title {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff7e7;
}

.desc {
  margin-top: 12rpx;
  color: #d5deea;
  line-height: 1.5;
}

.hook {
  margin-top: 12rpx;
  color: #ffd27a;
}
