.info-card {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 221, 160, 0.18);
  border-radius: 8rpx;
  background: rgba(22, 31, 45, 0.92);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff7e7;
}

.muted {
  margin-top: 6rpx;
  color: #aeb9c8;
  font-size: 24rpx;
}

.desc {
  margin-top: 12rpx;
  color: #d5deea;
  line-height: 1.5;
}
