.info-card {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(122, 101, 255, 0.12);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(78, 91, 177, 0.1);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111a3b;
}

.desc {
  margin-top: 12rpx;
  color: #4f5873;
  line-height: 1.5;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.tag {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  color: #34b979;
  background: #e9fff4;
  font-size: 24rpx;
}
