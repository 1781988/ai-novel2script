.scene-card {
  margin-bottom: 20rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 221, 160, 0.18);
  border-radius: 8rpx;
  background: rgba(22, 31, 45, 0.92);
}

.scene-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.scene-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff7e7;
}

.muted,
.meta {
  color: #aeb9c8;
  font-size: 24rpx;
}

.meta,
.conflict,
.beat {
  margin-top: 12rpx;
}

.conflict {
  color: #ffd27a;
}

.beat {
  display: grid;
  grid-template-columns: 130rpx 1fr;
  gap: 12rpx;
  color: #d5deea;
  line-height: 1.5;
}

.beat-type {
  color: #ffd27a;
}
