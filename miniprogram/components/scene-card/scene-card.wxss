.scene-card {
  margin-bottom: 20rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(122, 101, 255, 0.12);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(78, 91, 177, 0.1);
}

.scene-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.scene-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111a3b;
}

.muted,
.meta {
  color: #697189;
  font-size: 24rpx;
}

.meta,
.conflict,
.beat {
  margin-top: 12rpx;
}

.conflict {
  color: #756bff;
}

.beat {
  display: grid;
  grid-template-columns: 130rpx 1fr;
  gap: 12rpx;
  color: #4f5873;
  line-height: 1.5;
}

.beat-type {
  color: #756bff;
}
